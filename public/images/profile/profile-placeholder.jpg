<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 750" width="100%" height="100%">
  <defs>
    <filter id="newsprint" x="0%" y="0%" width="100%" height="100%">
      <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="3" result="noise" />
      <feColorMatrix type="matrix" values="0.33 0.33 0.33 0 0  0.33 0.33 0.33 0 0  0.33 0.33 0.33 0 0  0 0 0 1 0"/>
    </filter>
    <pattern id="halftone" width="6" height="6" patternUnits="userSpaceOnUse">
      <circle cx="3" cy="3" r="1.5" fill="#111" opacity="0.18"/>
    </pattern>
  </defs>

  <!-- Background -->
  <rect width="600" height="750" fill="#f4f1ea"/>
  <rect width="600" height="750" fill="url(#halftone)"/>

  <!-- Editorial Photo Border Frame -->
  <rect x="25" y="25" width="550" height="700" fill="none" stroke="#111" stroke-width="3"/>
  <rect x="35" y="35" width="530" height="680" fill="none" stroke="#111" stroke-width="1"/>

  <!-- Vintage Oval Vignette Backdrop -->
  <ellipse cx="300" cy="360" rx="200" ry="260" fill="#e8e4db" stroke="#222" stroke-width="1.5"/>

  <!-- Stylized Silhouette / Engraving of Software Engineer -->
  <!-- Suit / Shoulders -->
  <path d="M 170 650 C 180 500, 230 460, 300 460 C 370 460, 420 500, 430 650 Z" fill="#1c1b18" />
  <!-- Shirt Collar -->
  <polygon points="300,530 260,460 300,480 340,460" fill="#fdfbf7" stroke="#111" stroke-width="2"/>
  <!-- Neck Tie -->
  <polygon points="293,485 307,485 312,580 300,600 288,580" fill="#111"/>
  
  <!-- Head / Face -->
  <ellipse cx="300" cy="350" rx="90" ry="110" fill="#eddccb" stroke="#1c1b18" stroke-width="3"/>
  
  <!-- Classic Hair / Parting -->
  <path d="M 215 325 C 210 240, 290 220, 380 240 C 395 280, 385 320, 385 320 C 370 260, 310 250, 240 280 C 220 300, 215 325, 215 325 Z" fill="#1c1b18"/>
  
  <!-- Glasses (Editorial scholar look) -->
  <rect x="235" y="325" width="50" height="35" rx="6" fill="none" stroke="#111" stroke-width="4"/>
  <rect x="315" y="325" width="50" height="35" rx="6" fill="none" stroke="#111" stroke-width="4"/>
  <line x1="285" y1="340" x2="315" y2="340" stroke="#111" stroke-width="4"/>
  <line x1="220" y1="335" x2="235" y2="335" stroke="#111" stroke-width="3"/>
  <line x1="365" y1="335" x2="380" y2="335" stroke="#111" stroke-width="3"/>

  <!-- Eyes & Eyebrows -->
  <path d="M 240 315 Q 260 308 280 315" stroke="#111" stroke-width="3.5" fill="none"/>
  <path d="M 320 315 Q 340 308 360 315" stroke="#111" stroke-width="3.5" fill="none"/>
  <circle cx="260" cy="342" r="6" fill="#111"/>
  <circle cx="340" cy="342" r="6" fill="#111"/>

  <!-- Smile & Features -->
  <path d="M 296 350 L 292 375 L 305 375" stroke="#111" stroke-width="2.5" fill="none"/>
  <path d="M 270 395 Q 300 415 330 395" stroke="#111" stroke-width="3" fill="none"/>

  <!-- Classical Woodcut / Hatching Lines -->
  <g stroke="#111" stroke-width="1" opacity="0.35">
    <line x1="180" y1="560" x2="230" y2="560"/>
    <line x1="175" y1="575" x2="240" y2="575"/>
    <line x1="172" y1="590" x2="245" y2="590"/>
    <line x1="370" y1="560" x2="420" y2="560"/>
    <line x1="360" y1="575" x2="425" y2="575"/>
    <line x1="355" y1="590" x2="428" y2="590"/>
  </g>

  <!-- Editorial Banner Ribbon at Bottom -->
  <rect x="60" y="640" width="480" height="46" fill="#fcfbf7" stroke="#111" stroke-width="2"/>
  <text x="300" y="670" font-family="serif" font-size="19" font-weight="bold" letter-spacing="4" text-anchor="middle" fill="#111">SAHIL K. CHHATBAR</text>
  
  <text x="300" y="702" font-family="serif" font-size="11" font-style="italic" letter-spacing="1" text-anchor="middle" fill="#444">STAFF ARCHITECT &amp; SOFTWARE DEVELOPER</text>
</svg>
